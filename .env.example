# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NO se sube a git (ver .gitignore).

# --- Analytics (público, se expone en el navegador) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MAILCHIMP_ACTION=

# --- Mailchimp (SECRETO, solo servidor) ---
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

# --- Chat IA: Google Gemini (SECRETO, solo servidor) ---
# Consigue una API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.6-flash
GEMINI_MODEL=

# --- Envío de correo SMTP (SECRETO, solo servidor) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- Subida de imágenes a la galería (SECRETO, solo servidor) ---
# Único correo autorizado a subir imágenes.
GALLERY_ADMIN_EMAIL=
# Clave para firmar los códigos de verificación. Mínimo 32 caracteres.
# Genera una con: openssl rand -base64 48
GALLERY_AUTH_SECRET=
# Token de Vercel Blob. Se obtiene creando un Blob store en el panel de Vercel
# (Storage > Create > Blob) y se inyecta solo al enlazarlo con el proyecto.
BLOB_READ_WRITE_TOKEN=
