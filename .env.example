# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.

# Required for signed authentication cookies
AUTH_SECRET=your_random_32_byte_secret_here

# Password for protected routes
PAGE_ACCESS_PASSWORD=your_strong_password_here

# Google Analytics (public)
NEXT_PUBLIC_GA_ID=

# Mailchimp (public action URL)
NEXT_PUBLIC_MAILCHIMP_ACTION=

# Mailchimp API
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

# n8n AI Agent
N8N_PROTOCOL=https
N8N_HOST=
N8N_WEBHOOK_URL=
N8N_API_KEY=

# Newsletter notification webhook
NEWSLETTER_WEBHOOK_SECRET=
SITE_BASE_URL=https://your-domain.com

# Optional: enable automatic post notifications via a cron/admin endpoint only
# Do NOT enable this inside getServerPosts.
# AUTO_NOTIFY=false
