{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "include": ["src/components/react-bits/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off",
            "noSvgWithoutTitle": "off"
          },
          "complexity": {
            "noForEach": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "style": {
            "useExponentiationOperator": "off"
          }
        }
      }
    }
  ]
}
